index 0000000..0ddf6e2
--- /dev/null
+++ b/web/diagnostics.ts
@@ -0,0 +1,151 @@
+// Worker status board used to diagnose synchronous-call timeouts.
+//
+// The worker writes into a small Float64Array (over a SharedArrayBuffer the
+// main thread owns) which message it is running and which AccessHandlePoolVFS
+// operation is in progress. The main thread is busy-waiting on a sync call, so
+// it cannot receive messages, but it CAN read this board when its deadline
+// expires and append the worker's state to the timeout error.
+//
+// Board layout (Float64 slots; a zeroed buffer means "idle"):
+//   0  current message id + 1 (0 = idle)
+//   1  message start time (Date.now())
+//   2  running VFS op code (1-based index into VFS_OPS, 0 = none)
+//   3  running VFS op start time (Date.now())
+//   4  slowest completed VFS op code of this message (0 = none)
+//   5  slowest completed VFS op duration in ms
+//   6-7 reserved
+//   8..16   per-op completed count of this message (8 + op code - 1)
+//   17..25  per-op total ms of this message (17 + op code - 1)
+//   26-31 reserved
+
+export const VFS_OPS = [
+  'jOpen',
+  'jClose',
+  'jRead',
+  'jWrite',
+  'jTruncate',
+  'jSync',
+  'jFileSize',
+  'jDelete',
+  'jAccess',
+] as const;
+
+export const DIAG_SLOTS = 32;
+
+const SLOT_MESSAGE = 0;
+const SLOT_MESSAGE_START = 1;
+const SLOT_OP = 2;
+const SLOT_OP_START = 3;
+const SLOT_SLOWEST_OP = 4;
+const SLOT_SLOWEST_MS = 5;
+const SLOT_COUNT_BASE = 8;
+const SLOT_TOTAL_BASE = SLOT_COUNT_BASE + VFS_OPS.length;
+
+/** At most this many per-op totals are listed in the timeout message. */
+const MAX_LISTED_OPS = 4;
+
+export function createDiagBoard(): SharedArrayBuffer {
+  return new SharedArrayBuffer(DIAG_SLOTS * Float64Array.BYTES_PER_ELEMENT);
+}
+
+/** Worker: a message started. Resets the per-message op counters. */
+export function markMessageStart(board: Float64Array, id: number, now: number = Date.now()): void {
+  board.fill(0, SLOT_OP, DIAG_SLOTS);
+  board[SLOT_MESSAGE] = id + 1;
+  board[SLOT_MESSAGE_START] = now;
+}
+
+/** Worker: a message finished. Ignored if the board already moved on to another message. */
+export function markMessageEnd(board: Float64Array, id: number): void {
+  if (board[SLOT_MESSAGE] === id + 1) {
+    board[SLOT_MESSAGE] = 0;
+    board[SLOT_OP] = 0;
+  }
+}
+
+const AsyncFunction = (async () => {}).constructor;
+const instrumented = new WeakSet<object>();
+
+/**
+ * Wraps the synchronous AccessHandlePoolVFS methods so each call is recorded on
+ * the board. Return values and exceptions pass through untouched. Async methods
+ * are skipped because wa-sqlite detects them with `instanceof AsyncFunction`.
+ */
+export function instrumentVfs<T extends object>(
+  vfs: T,
+  getBoard: () => Float64Array | null,
+  now: () => number = Date.now
+): T {
+  if (instrumented.has(vfs)) return vfs;
+  instrumented.add(vfs);
+  const target = vfs as Record<string, any>;
+  VFS_OPS.forEach((name, index) => {
+    const original = target[name];
+    if (typeof original !== 'function' || original instanceof AsyncFunction) return;
+    const code = index + 1;
+    target[name] = function (this: unknown, ...args: unknown[]) {
+      const board = getBoard();
+      if (!board) return original.apply(this, args);
+      const startedAt = now();
+      board[SLOT_OP] = code;
+      board[SLOT_OP_START] = startedAt;
+      try {
+        return original.apply(this, args);
+      } finally {
+        const elapsed = now() - startedAt;
+        board[SLOT_OP] = 0;
+        board[SLOT_COUNT_BASE + index] += 1;
+        board[SLOT_TOTAL_BASE + index] += elapsed;
+        if (elapsed > board[SLOT_SLOWEST_MS]) {
+          board[SLOT_SLOWEST_OP] = code;
+          board[SLOT_SLOWEST_MS] = elapsed;
+        }
+      }
+    };
+  });
+  return vfs;
+}
+
+/**
+ * Main thread: renders the board for a timed-out call. `call.describe` returns
+ * a description ("type: SQL") of an earlier call by id, when known.
+ */
+export function formatWorkerState(
+  board: Float64Array,
+  now: number,
+  call: { id: number; describe: (id: number) => string | null }
+): string {
+  const current = board[SLOT_MESSAGE] - 1;
+  if (current < 0) return 'worker: idle';
+
+  const parts: string[] = [];
+  const running = Math.max(0, now - board[SLOT_MESSAGE_START]);
+  if (current === call.id) {
+    parts.push(`running this call for ${running} ms`);
+  } else {
+    parts.push(`still on #${current} ${call.describe(current) ?? '(unknown call)'} for ${running} ms`);
+  }
+
+  const opCode = board[SLOT_OP];
+  if (opCode > 0) {
+    parts.push(`in ${VFS_OPS[opCode - 1]} for ${Math.max(0, now - board[SLOT_OP_START])} ms`);
+  } else {
+    parts.push('no VFS op active');
+  }
+
+  if (board[SLOT_SLOWEST_OP] > 0) {
+    parts.push(`slowest ${VFS_OPS[board[SLOT_SLOWEST_OP] - 1]} ${board[SLOT_SLOWEST_MS]} ms`);
+  }
+
+  const totals = VFS_OPS.map((name, index) => ({
+    name,
+    count: board[SLOT_COUNT_BASE + index],
+    ms: board[SLOT_TOTAL_BASE + index],
+  }))
+    .filter((op) => op.count > 0)
+    .sort((a, b) => b.ms - a.ms)
+    .slice(0, MAX_LISTED_OPS);
+  for (const op of totals) parts.push(`${op.name}×${op.count} ${op.ms} ms`);
+
+  return `worker: ${parts.join(', ')}`;
+}
